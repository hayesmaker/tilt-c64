{
  "name": "tilt-level-editor",
  "private": true,
  "version": "0.1.0",
  "description": "Web maze editor for Tilt (C64), builds tilt-mod cartridges",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "vite build && node server/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "c64-ready": "^2.5.0"
  }
}
